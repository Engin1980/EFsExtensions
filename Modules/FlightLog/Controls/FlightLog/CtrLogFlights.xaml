<base:FlightsBasedUserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.CtrLogFlights"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             xmlns:base="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.Shared"
             xmlns:ctrIn="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Flights"
             xmlns:cvts="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <base:FlightsBasedUserControl.Resources>
    <cvts:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
  </base:FlightsBasedUserControl.Resources>
  <DockPanel x:Name="pnlMain">
    <ctrIn:CtrLogFlightDetail DockPanel.Dock="Bottom" Visibility="{Binding SelectedFlight, Converter={StaticResource NotNullToVisibilityConverter}}"  />
    <ctrIn:CtrLogFlightList />
  </DockPanel>
</base:FlightsBasedUserControl>
