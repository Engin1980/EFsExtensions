<Window x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Stats.FrmStatsDictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Stats"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="800">
  <DockPanel Margin="8">
    <Label DockPanel.Dock="Top" Content="{Binding Title}" FontWeight="Bold" />
    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" >
      <DataGrid.Columns>
        <DataGridTextColumn Header="Key" Binding="{Binding Index, StringFormat={}{0}.}" />
        <DataGridTextColumn Header="Key" Binding="{Binding Key}" />
        <DataGridTextColumn Header="Count" Binding="{Binding Count}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
