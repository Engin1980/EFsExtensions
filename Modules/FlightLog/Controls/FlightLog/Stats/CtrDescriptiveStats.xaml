<UserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Stats.CtrDescriptiveStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Stats"
             xmlns:cvts="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Converters"
             xmlns:ctr="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <DataGrid ItemsSource="{Binding DescriptiveStats}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
    <DataGrid.Columns>
      <DataGridTemplateColumn Header="Title">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Label Content="{Binding Stat.Title}" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Min">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Label>
              <TextBlock Text="{Binding Min.DisplayValue}" TextAlignment="Right" Width="100"/>
              <Label.ToolTip>
                <ctr:CtrLogFlightToolTip LogFlight="{Binding Min.Flight}" />
              </Label.ToolTip>
            </Label>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Max">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Label >
              <TextBlock Text="{Binding Max.DisplayValue}" TextAlignment="Right" Width="100"/>
              <Label.ToolTip>
                <ctr:CtrLogFlightToolTip LogFlight="{Binding Max.Flight}" />
              </Label.ToolTip>
            </Label>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Avg">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Label>
              <TextBlock Text="{Binding Avg}" TextAlignment="Right" Width="100" />
            </Label>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
            <Button Padding="16 0 16 0">(...)</Button>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
