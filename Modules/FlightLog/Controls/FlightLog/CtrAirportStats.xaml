<base:FlightsBasedUserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.CtrAirportStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             xmlns:base="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.Shared"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <DockPanel x:Name="pnlMain">
    <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Seleted Airport ICAO:" Margin="8 0 0 0" />
        <ComboBox ItemsSource="{Binding ICAOs}" SelectedItem="{Binding SelectedICAO}" Width="100"/>
      </StackPanel>
    </DockPanel>
    <mapsui:MapControl x:Name="ctrMap" />
  </DockPanel>
</base:FlightsBasedUserControl>
