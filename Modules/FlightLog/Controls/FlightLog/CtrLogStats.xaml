<base:FlightsBasedUserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.CtrLogStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             xmlns:ctr="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.Shared"
             xmlns:cvts="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Converters"
             xmlns:ctrIn="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.Stats"
             xmlns:base="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <base:FlightsBasedUserControl.Resources>
    <cvts:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    <cvts:LongDistanceConverter x:Key="LongDistanceConverter" />
    <cvts:ShortDistanceConverter x:Key="ShortDistanceConverter" />
    <cvts:SpeedConverter x:Key="SpeedConverter" />
    <cvts:WeightConverter x:Key="WeightConverter" />
    <Style x:Key="TextRight" TargetType="{x:Type TextBlock}">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </base:FlightsBasedUserControl.Resources>
  <DockPanel x:Name="pnlMain">
    <ctr:FlightLogFilter x:Name="ctrFilter" DockPanel.Dock="Top" />
    <TabControl>
      <TabItem Header="Overall">
        <Grid DataContext="{Binding OverallStats}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="69*" />
            <ColumnDefinition Width="265*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Label Grid.Row="0" Grid.Column="0" Content="Total flights:" />
          <Label Grid.Row="0" Content="{Binding TotalFlights}" Grid.ColumnSpan="3" Margin="125,0,0,0" />

          <Label Grid.Column="0" Content="Total block time:" Margin="0,29,0,0" Grid.RowSpan="2" />
          <ctr:TimeSpanLabel Value="{Binding TotalBlockDuration}" StringFormat="d. h:mm:ss" Grid.ColumnSpan="3" Margin="125,29,0,0" Grid.RowSpan="2" />

          <Label Grid.Row="1" Grid.Column="0" Content="Total air time:" Margin="0,29,0,0" Grid.RowSpan="2" />
          <ctr:TimeSpanLabel Grid.Row="1" Value="{Binding TotalAirDuration}" StringFormat="d. h:mm:ss" Grid.ColumnSpan="3" Margin="125,29,0,0" Grid.RowSpan="2" />
        </Grid>
      </TabItem>
      <TabItem Header="Descriptive">
        <ctrIn:CtrDescriptiveStats />
      </TabItem>
      <TabItem Header="Grouping">
        <ctrIn:CtrGroupingStats />
      </TabItem>
      <TabItem Header="Detailed">
        <ctrIn:CtrDetailedStats />
      </TabItem>
      <TabItem Header="Map">
        <ctrIn:CtrMap />
      </TabItem>
    </TabControl>
  </DockPanel>
</base:FlightsBasedUserControl>
