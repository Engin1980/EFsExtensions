<UserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.CtrPlanesOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             xmlns:cvts="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             >
  <UserControl.Resources>
    <cvts:TimeSpanConverter x:Key="TimeSpanConverter" />
    <cvts:DateTimeConverter x:Key="DateTimeConverter" />
    <Style x:Key="AircraftCardStyle" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="10"/>
      <Setter Property="BorderBrush" Value="#CCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Right" Width="500">
      <mapsui:MapControl x:Name="ctrMap" />
    </Grid>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Fleet.Airplanes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"
                       ItemWidth="300"
                       ItemHeight="Auto"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#CCC"
                    Padding="12"
                    Margin="10">

              <StackPanel Orientation="Vertical">
                <Label Content="{Binding Registration}"
                           FontWeight="Bold"
                           FontSize="16" />

                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                  <TextBlock Text="Flights: " />
                  <TextBlock Text="{Binding TotalFlights}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                  <TextBlock Text="Total block time: " />
                  <TextBlock Text="{Binding TotalTime, Converter={StaticResource TimeSpanConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                  <TextBlock Text="Current location: " />
                  <TextBlock Text="{Binding LastLocationICAO}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                  <TextBlock Text="Last flight: " />
                  <TextBlock Text="{Binding LastFlightDate, Converter={StaticResource DateTimeConverter}}" />
                </StackPanel>
              </StackPanel>

            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </ScrollViewer>
  </DockPanel>
</UserControl>
