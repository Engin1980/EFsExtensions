<UserControl x:Class="Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog.CtrLogFlightMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             xmlns:ctrIn="clr-namespace:Eng.EFsExtensions.Modules.FlightLogModule.Controls.FlightLog"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <DockPanel DataContext="{Binding VM, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <TabControl>
      <TabItem Header="Fleet" >
        <local:CtrPlanesOverview />
      </TabItem>
      <TabItem Header="Flights" >
        <local:CtrLogFlights Flights="{Binding Flights}" />
      </TabItem>
      <TabItem Header="Stats">
        <ctrIn:CtrLogStats Flights="{Binding Flights}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
